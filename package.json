{
  "name": "indihome-payment-check",
  "version": "1.0.0",
  "description": "Aplikasi pengecekan tagihan IndiHome otomatis",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "author": "Nama Anda",
  "build": {
    "appId": "com.indihome.paymentchecker",
    "productName": "IndiHome Checker",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.13.3"
  }
}